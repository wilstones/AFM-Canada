{
  "name": "afm-canada-website",
  "version": "1.0.0",
  "description": "AFM in Canada - Interactive Church Website with Blog Management",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite",
